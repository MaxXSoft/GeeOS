import geeos.lib.alloc.heap
import geeos.mem.heap.initHeapMem
import geeos.mem.consts.HEAP_SIZE
import runtime.heap_cases.runHeapCases


def allocate(size: usize): u8 var* {
  heap.alloc(size)
}

def release(ptr: u8 var*) {
  heap.dealloc(ptr)
}

extern def test_main(): i32 {
  initHeapMem()
  runHeapCases(allocate, release, HEAP_SIZE as usize)
}
