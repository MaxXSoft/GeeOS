extern declare test_check: (bool, u8*)

public def runHeapCases(allocate: (usize): u8 var*,
                       release: (u8 var*), capacity: usize): i32 {
  // The largest legal block consumes the whole arena, including its header.
  let full = allocate(capacity - 8)
  test_check(full != null, "largest allocation fits")
  full[0] = 17
  full[capacity - 9] = 23
  test_check(allocate(1) == null, "full heap rejects allocation")
  test_check(full[0] == 17 && full[capacity - 9] == 23,
             "exhaustion preserves allocation")
  release(full)

  let guard = allocate(17)
  test_check(guard != null, "small allocation after exhaustion")
  var i: usize = 0
  while i < 17 {
    guard[i] = (i + 1) as u8
    i += 1
  }
  // Cover both byte-rounding overflow and header-count multiplication wrap.
  var size: usize = 0xffffffff
  var count = 0
  while count < 512 {
    test_check(allocate(size) == null, "oversized allocation rejected")
    size -= 1
    count += 1
  }
  test_check(allocate(capacity) == null, "capacity excludes header")
  test_check(allocate(capacity + 1) == null, "over-capacity rejected")
  i = 0
  while i < 17 {
    test_check(guard[i] == (i + 1) as u8, "failed requests preserve live data")
    i += 1
  }
  release(guard)

  // Exercise 0, small alignments, multi-header sizes and coalescing together.
  var blocks: u8 var*[64]
  i = 0
  while i < 64 {
    let size = i * 3
    blocks[i] = allocate(size)
    test_check(blocks[i] != null, "small allocations remain usable")
    var j: usize = 0
    while j < size {
      blocks[i][j] = (i + j) as u8
      j += 1
    }
    i += 1
  }
  i = 0
  while i < 64 {
    var j: usize = 0
    while j < i * 3 {
      test_check(blocks[i][j] == (i + j) as u8, "allocations do not overlap")
      j += 1
    }
    release(blocks[i])
    i += 1
  }
  let coalesced = allocate(capacity - 8)
  test_check(coalesced != null, "freed blocks coalesce")
  release(coalesced)
  0
}
