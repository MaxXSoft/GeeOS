import lib.io
import lib.sys.syscall

extern def main(argc: i32, argv: u8**): i32 {
  if execve("fault_illegal", null as u8**, null as u8**) != 0 ||
     execve("fault_break", null as u8**, null as u8**) != 0 {
    io <<< "FAIL: exception child could not start\n"; return 1
  }
  io <<< "PASS: user_faults\n"
  0
}
