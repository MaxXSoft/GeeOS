import grt.lib.io.io
import grt.lib.sys.syscall.{close, lseek, open, read, write}


extern def main(argc: i32, argv: u8**): i32 {
  let fd = open("/big", 2)
  if fd < 0 { io <<< "FAIL: open big\n"; return 1 }
  lseek(fd, 123, 0)
  if write(fd, "X", 1) != -1 || lseek(fd, 0, 1) != 123 {
    io <<< "FAIL: failed I/O changed offset\n"; return 1
  }
  var buf: u8[2]
  if read(fd, buf as u8 var*, 2) != 2 ||
     lseek(fd, 0, 1) != 125 {
    io <<< "FAIL: successful I/O offset\n"; return 1
  }
  lseek(fd, 53009, 0)
  if read(fd, buf as u8 var*, 2) != 0 ||
     lseek(fd, 0, 1) != 53009 {
    io <<< "FAIL: EOF changed offset\n"; return 1
  }
  close(fd)
  io <<< "PASS: io_error\n"
  0
}
