import lib.io
import lib.sys.syscall

def check(ok: bool, message: u8*) {
  if !ok { io <<< "FAIL: " <<< message <<< '\n'; exit(1 as usize) }
}

extern def main(argc: i32, argv: u8**): i32 {
  let readonly = "readonly" as u8*
  let bad = null as u8 var*
  check(fstat(1, null as Stat var*) == -1, "null stat buffer")
  check(chdir(null as u8*) == -1, "null chdir path")
  check(open(null as u8*, 0) == -1, "null open path")
  check(execve(null as u8*, null as u8**, null as u8**) == -1, "null exec path")
  check(write(1, bad as u8*, 1 as usize) == -1, "null write buffer")
  check(write(1, 0x80000000 as u8*, 1 as usize) == -1, "kernel write buffer")
  check(write(1, 0x10000000 as u8*, 1 as usize) == -1, "device write buffer")
  check(write(1, 0xfffffffe as u8*, 4 as usize) == -1, "wrapping write range")
  check(write(1, "ok", 0xffffffff as usize) == -1, "oversized write range")
  let last = 0x7fffefff as u8 var*
  *last = 'x'
  check(open(last as u8*, 0) == -1, "unterminated path at stack end")
  let fd = open("/big", 0)
  check(fd >= 0, "open big")
  check(read(fd, bad, 1 as usize) == -1, "null read buffer")
  check(read(fd, 0x7fffefff as u8 var*, 2 as usize) == -1, "range crossing stack end")
  check(read(fd, readonly as usize as u8 var*, 1 as usize) == -1, "readonly read buffer")
  check(fstat(fd, readonly as usize as Stat var*) == -1, "readonly stat buffer")
  check(lseek(fd, 0 as usize, 1) == 0 as usize, "invalid read preserves offset")
  check(read(fd, bad, 0 as usize) == 0, "zero-length null buffer")
  // Exercise an unaligned output buffer without misaligned word stores.
  var stat_bytes: u8[24]
  check(fstat(fd, ((stat_bytes as u8 var*) + 1) as Stat var*) == 0, "unaligned stat buffer")
  var buf: u8[2]
  check(read(fd, buf as u8 var*, 2 as usize) == 2, "valid read after errors")
  close(fd)
  io <<< "PASS: user_buffers\n"
  0
}
