import lib.io
import lib.sys.syscall

extern def main(argc: i32, argv: u8**): i32 {
  let paths = [u8*[19]] {
    "elf_empty", "elf_short", "elf_phshort", "elf_class", "elf_endian",
    "elf_ehsize", "elf_phsize", "elf_phoffset", "elf_phalign", "elf_phcount",
    "elf_fileoff", "elf_filesize", "elf_memsize", "elf_kernel", "elf_stack",
    "elf_uart", "elf_wrap", "elf_entry", "elf_overlap"
  }
  var i = 0
  while i < 19 {
    let path = paths[i]
    i += 1
    io <<< "CHECK: " <<< path <<< '\n'
    if execve(path, null as u8**, null as u8**) >= 0 {
      io <<< "FAIL: accepted " <<< path <<< '\n'
      return 1
    }
  }
  io <<< "PASS: elf_reject\n"
  0
}
