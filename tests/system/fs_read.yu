import grt.lib.io.io
import grt.lib.sys.syscall.{close, lseek, open, read}


// Match the independently generated byte pattern in run.py.
def checkBytes(buf: u8*, offset: usize, count: usize): bool {
  var i: usize = 0
  while i < count {
    let p = offset + i
    if buf[i] != ((p * 37 + p / 256) % 251) as u8 {
      return false
    }
    i += 1
  }
  true
}

extern def main(argc: i32, argv: u8**): i32 {
  let fd = open("/big", 0)
  var buf: u8[1024], offset: usize = 0
  if fd < 0 { io <<< "FAIL: open big\n"; return 1 }
  while offset < 53009 {
    let count = read(fd, buf as u8 var*, 1024)
    if count <= 0 || !checkBytes(buf as u8*, offset, count as usize) {
      io <<< "FAIL: fs_read at " <<< offset <<< '\n'
      return 1
    }
    offset += count as usize
  }
  if read(fd, buf as u8 var*, 1024) != 0 {
    io <<< "FAIL: read past EOF\n"; return 1
  }
  // Unaligned requests across each addressing boundary and subtable switch.
  let boundaries = [usize[4]] {3072, 19456, 35840, 52224}
  var i = 0
  while i < 4 {
    let boundary = boundaries[i]
    lseek(fd, boundary - 1, 0)
    if read(fd, buf as u8 var*, 3) != 3 ||
       !checkBytes(buf as u8*, boundary - 1, 3) {
      io <<< "FAIL: fs_read boundary " <<< boundary <<< '\n'; return 1
    }
    i += 1
  }
  // Zero-length reads preserve the offset; short reads stop exactly at EOF.
  lseek(fd, 53008, 0)
  if read(fd, buf as u8 var*, 0) != 0 ||
     lseek(fd, 0, 1) != 53008 ||
     read(fd, buf as u8 var*, 3) != 1 ||
     !checkBytes(buf as u8*, 53008, 1) {
    io <<< "FAIL: fs_read short or empty read\n"; return 1
  }
  lseek(fd, -1 as usize, 0)
  if read(fd, buf as u8 var*, 1) != 0 {
    io <<< "FAIL: fs_read large offset\n"; return 1
  }
  close(fd)
  io <<< "PASS: fs_read\n"
  0
}
