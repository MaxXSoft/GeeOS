import geeos.define.context.{Context, newKernelContext, newNullContext, newUserContext}
import geeos.arch.target.GEEOS_TARGET.{PLIC_ADDR, PLIC_END, UART_ADDR, UART_END}
import geeos.arch.riscv.csr.getSatp
import geeos.mem.mset.{MemorySet, newMemorySet}
import geeos.mem.paging.newPageRange
import geeos.arch.riscv.consts.{MEGAPAGE_SIZE, PAGE_SIZE}
import geeos.mem.attr.{MemoryAttr, newMemoryAttr}
import geeos.mem.handler.newFrameHandler
import geeos.fs.info.FileInfo
import geeos.lib.c.string.{memcpy, memset}
import geeos.proc.consts.{Tid, USER_STACK_OFFSET, USER_STACK_SIZE}
import geeos.mem.pm.{allocPhyMem, freePhyMem}
import geeos.lib.except.{assert, panic}
import geeos.lib.alloc.heap
import geeos.lib.elf.{Elf32Ehdr, Elf32Phdr, ElfEtype, ElfFile, ElfPhdrIter, ElfPtype, newElfFile, newElfPhdrIter}


// size of kernel stack
// must be page size because stack is allocated by frame allocator
let STACK_SIZE  = PAGE_SIZE as usize

// definition of kernel thread stack
public struct KernelStack {
  addr: u8 var*,
}

// create new kernel stack
public def newKernelStack(): KernelStack {
  let addr = allocPhyMem()
  assert(addr as i32 != 0, "newKernelStack - OOM")
  [] {addr}
}

// release kernel stack
public def del(this: KernelStack var&) {
  if this.addr as i32 != 0 {
    freePhyMem(this.addr)
  }
  this.addr = null
}

// get top of kernel stack
public def getTop(this: KernelStack&): usize {
  this.addr as usize + STACK_SIZE
}


// definition of process
public struct Process {
  public vm: MemorySet,
  fds: FileInfo,
  thread_count: i32,
}

def newProcess(vm: MemorySet): Process var* {
  let proc = heap.alloc(sizeof Process) as Process var*
  (*proc).vm = vm
  (*proc).fds.init()
  (*proc).thread_count = 0
  proc
}

def del(this: Process var*) {
  assert((*this).thread_count == 0, "Process.del")
  (*this).vm.del()
  (*this).fds.del()
  heap.dealloc(this as u8 var*)
}

def incCounter(this: Process var*): Process var* {
  (*this).thread_count += 1
  this
}

def decCounter(this: Process var*): Process var* {
  (*this).thread_count -= 1
  if (*this).thread_count < 0 {
    panic("decCounter")
  }
  else if (*this).thread_count == 0 {
    this.del()
  }
  this
}

def getFds(this: Process var*): FileInfo var& {
  (*this).fds
}


// definition of thread
// objects of this structure will always be allocated on the heap
public struct Thread {
  context: Context,
  kstack: KernelStack,
  public proc: Process var*,
  wait: Tid,
}

// The loader supports ELF32 little-endian RISC-V executables with distinct
// load pages. Validate every range before creating mappings or reading data.
def validUserElf(data: u8*, size: usize): bool {
  if size < sizeof Elf32Ehdr { return false }
  let ehdr = data as Elf32Ehdr*
  if !ehdr.isValid() || ehdr.getType() != ElfEtype.Executable ||
     ((*ehdr).e_ident[1] & 0xffffff) != 0x010101 ||
     (*ehdr).e_version != 1 ||
     (*ehdr).e_ehsize as usize != sizeof Elf32Ehdr ||
     (*ehdr).e_phentsize as usize != sizeof Elf32Phdr {
    return false
  }
  let phoff = (*ehdr).e_phoff as usize
  let count = (*ehdr).e_phnum as usize
  if phoff % 4 != 0 || phoff > size ||
     count > (size - phoff) / sizeof Elf32Phdr {
    return false
  }
  let headers = ehdr.getPhdr()
  var entry_found = false, i: usize = 0
  while i < count {
    let ph = headers + i
    if ph.getType() == ElfPtype.Load {
      let offset = ph.getOffset() as usize
      let file_size = ph.getFileSize() as usize
      let mem_size = ph.getMemSize() as usize
      let start = ph.getVaddr() as usize
      if offset > size || file_size > size - offset || file_size > mem_size {
        return false
      }
      if mem_size != 0 {
        // The fixed user stack and kernel mappings must remain untouched.
        if start >= USER_STACK_OFFSET as usize ||
           mem_size > USER_STACK_OFFSET as usize - start {
          return false
        }
        let end = start + mem_size
        // mapKernel reserves whole megapages for its device mappings,
        // including the megapage containing each inclusive end address.
        let first = start / MEGAPAGE_SIZE as usize
        let last = (end - 1) / MEGAPAGE_SIZE as usize
        if (first <= UART_END as usize / MEGAPAGE_SIZE as usize &&
            last >= UART_ADDR as usize / MEGAPAGE_SIZE as usize) ||
           (first <= PLIC_END as usize / MEGAPAGE_SIZE as usize &&
            last >= PLIC_ADDR as usize / MEGAPAGE_SIZE as usize) {
          return false
        }
        var j: usize = 0
        while j < i {
          let other = headers + j
          if other.getType() == ElfPtype.Load &&
             other.getMemSize() != 0 {
            let other_start = other.getVaddr() as usize
            let other_end = other_start + other.getMemSize()
            if start / PAGE_SIZE as usize <=
                 (other_end - 1) / PAGE_SIZE as usize &&
               other_start / PAGE_SIZE as usize <=
                 (end - 1) / PAGE_SIZE as usize {
              return false
            }
          }
          j += 1
        }
        let entry = ehdr.getEntry() as usize
        if ph.isExecute() && entry >= start && entry < end &&
           entry % 2 == 0 {
          entry_found = true
        }
      }
    }
    i += 1
  }
  entry_found
}

// Use pointer arithmetic after widening e_phnum, rather than multiplying
// the two 16-bit header fields in ElfFile.getPhdrIter().
def getLoadPhdrIter(this: ElfFile&): ElfPhdrIter {
  let ehdr = this.getEhdr(), first = ehdr.getPhdr()
  newElfPhdrIter(first, first + (*ehdr).e_phnum as usize)
}

// create memory attribute by ELF program header
def toAttr(this: Elf32Phdr*): MemoryAttr {
  var attr = newMemoryAttr().setUser()
  if this.isExecute() {
    attr = attr.setExecute()
  }
  if !this.isWrite() {
    attr = attr.setReadonly()
  }
  attr
}

// create memory set by ELF file
def makeMemorySet(this: ElfFile&): MemorySet {
  // create a new memory set with kernel mapping
  var ms = newMemorySet()
  // traverse program headers in ELF file
  let handler = newFrameHandler()
  for ph in this.getLoadPhdrIter() {
    if ph.getType() != ElfPtype.Load || ph.getMemSize() == 0 {
      continue
    }
    let start = ph.getVaddr() as usize
    let end = start + ph.getMemSize()
    let data = this.getPhdrData(ph)
    let file_end = start + ph.getFileSize()
    ms.push(start, end, ph.toAttr(), handler)
    // Initialize through the kernel's physical mapping. User mappings and
    // MemoryArea metadata retain their final ELF permissions throughout.
    for pt in ms.page_table.edit() {
      for page in newPageRange(start, end) {
        let frame = pt.getEntry(page).getTarget() as u8 var*
        memset(frame, 0, PAGE_SIZE as usize)
        let copy_start = if start > page { start } else { page }
        let page_end = page + PAGE_SIZE as usize
        let copy_end = if file_end < page_end { file_end } else { page_end }
        if copy_start < copy_end {
          memcpy(frame + (copy_start - page), data + (copy_start - start),
                 copy_end - copy_start)
        }
      }
    }
  }
  // Newly copied executable bytes must be visible to instruction fetch.
  asm { "fence.i" }
  ms
}

// create new idle thread
public def newIdleThread(): Thread var* {
  let thread = heap.alloc(sizeof Thread) as Thread var*
  (*thread) = [] {
    newNullContext(),
    newKernelStack(),
    null,
    0,
  }
  thread
}

// create new kernel thread
public def newKernelThread(entry: usize): Thread var* {
  let kstack = newKernelStack()
  let thread = heap.alloc(sizeof Thread) as Thread var*
  (*thread) = [] {
    newKernelContext(entry, kstack.getTop(), getSatp()),
    kstack,
    null,
    0,
  }
  thread
}

// create new user thread
public def newUserThread(data: u8*, size: usize,
                         wait_thread: Tid): Thread var* {
  if !validUserElf(data, size) {
    return null
  }
  // get entry point
  let elf = newElfFile(data), ehdr = elf.getEhdr()
  let entry = ehdr.getEntry()
  // create page table & user stack
  var ms = elf.makeMemorySet()
  let ustack_top = {
    let ustack_bottom = USER_STACK_OFFSET as usize
    let ustack_top = (USER_STACK_OFFSET + USER_STACK_SIZE) as usize
    let handler = newFrameHandler()
    ms.push(ustack_bottom, ustack_top, newMemoryAttr().setUser(), handler)
    ustack_top
  }
  // create process
  let proc = newProcess(ms).incCounter()
  proc.getFds().initStdFds()
  // create kernel stack & user thread
  let kstack = newKernelStack()
  let thread = heap.alloc(sizeof Thread) as Thread var*
  (*thread) = [] {
    newUserContext(entry as usize, ustack_top, kstack.getTop(), ms.token()),
    kstack,
    proc,
    wait_thread,
  }
  thread
}

// release current thread structure
public def del(this: Thread var*) {
  (*this).kstack.del()
  if (*this).proc != null {
    (*this).proc.decCounter()
  }
  heap.dealloc(this as u8 var*)
}

// append initial arguments for current thread
public def appendInitArgs(this: Thread*, args: usize[3]) {
  (*this).context.appendInitArgs(args)
}

// switch to target thread
public def switchTo(this: Thread var*, target: Thread var*) {
  (*this).context.switchTo((*target).context)
}

// get file info
public def getFds(this: Thread var*): FileInfo var& {
  assert((*this).proc != null, "Thread.getFds")
  (*this).proc.getFds()
}

// get wait thread
public inline def getWait(this: Thread var*): Tid {
  (*this).wait
}
