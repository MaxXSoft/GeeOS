import geeos.proc.consts.{TID_NONE, TIME_SLICE, Tid}
import geeos.proc.structs.{Thread, newUserThread}
import geeos.arch.riscv.csr.setIntrOn
import geeos.lib.strview.newStrView
import geeos.fs.fs.root_inode
import geeos.lib.alloc.heap
import geeos.proc.processor.{Processor, newProcessor}
import geeos.lib.except.assert


// current processor
var cpu: Processor var*


// execute new process
public def execute(path: u8*, host_tid: Tid): bool {
  let path = newStrView(path)
  // find file in root inode
  let inode = root_inode.lookup(path)
  if inode != null {
    var ret = false
    inode.open()
    // read content of inode
    let meta = inode.getMetadata()
    let size = meta.size, buf = heap.alloc(size)
    if buf != null &&
       inode.read(buf, size, 0) as usize == size {
      // create user thread
      let thread = newUserThread(buf, size, host_tid)
      if thread != null {
        cpu.addThread(thread)
        ret = true
      }
    }
    // free buffer & inode
    if buf != null { heap.dealloc(buf) }
    inode.close()
    ret
  }
  else {
    false
  }
}

// initialize process
public def initProcess() {
  cpu = newProcessor(TIME_SLICE)
  let ret = execute("shell", TID_NONE)
  assert(ret, "initProcess")
}

// turn interrupt on and run scheduler on current CPU
public def runCpu() {
  setIntrOn()
  cpu.run()
}

public def yield() {
  cpu.yield()
}

public def tick() {
  cpu.tick()
}

public def exit(code: usize) {
  cpu.exit(code)
}

public def sleep() {
  cpu.sleep()
}

public def wakeUp(tid: Tid) {
  cpu.wakeUp(tid)
}

public def getCurrentTid(): Tid {
  cpu.getCurrentTid()
}

public def getCurrentThread(): Thread var* {
  cpu.getCurrentThread()
}

// Static entry points for proc.scheduling. Keep the Yu API above unchanged.
extern def geeos_sched_current_tid(): usize {
  getCurrentTid()
}

extern def geeos_sched_sleep() {
  sleep()
}

extern def geeos_sched_wake_up(tid: usize) {
  wakeUp(tid)
}
