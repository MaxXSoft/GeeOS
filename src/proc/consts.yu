


// some definitions about process managing

// type alias of thread id
public type Tid = usize

// tid for 'none'
public inline let TID_NONE           = -1 as Tid

// maximum number of thread
public inline let MAX_THREAD_COUNT   = 128

// maximum time slice of round robin scheduler
public inline let TIME_SLICE: usize         = 1

// stack of user thread
public inline let USER_STACK_SIZE    = 0x10000
public inline let USER_STACK_OFFSET  = 0x7ffff000 - USER_STACK_SIZE
