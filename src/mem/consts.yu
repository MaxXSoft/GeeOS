import geeos.arch.target.GEEOS_TARGET.{MEM_ADDR, MEM_SIZE_MIB}


// position definitions in 'linker.ld'
public extern declare _geeos_start: ()
public extern declare _geeos_end: ()
public extern declare _text_start: ()
public extern declare _text_end: ()
public extern declare _rodata_start: ()
public extern declare _rodata_end: ()
public extern declare _data_start: ()
public extern declare _data_end: ()
public extern declare _bss_start: ()
public extern declare _bss_end: ()
public extern declare _stack_start: ()
public extern declare _stack_end: ()

// definitions about physical memory
public inline let KERNEL_BASE    = MEM_ADDR
public inline let KERNEL_VM_BASE = 0x80000000
public inline let PHY_STOP       = KERNEL_BASE + MEM_SIZE_MIB * 1024 * 1024
// Process/page-table metadata still needs a usable heap on small RAM targets.
public inline let HEAP_SIZE      = if MEM_SIZE_MIB < 128 { 128 * 1024 }
                            else { MEM_SIZE_MIB * 1024 }
public inline let HEAP_BASE      = PHY_STOP - HEAP_SIZE
