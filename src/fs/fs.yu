import geeos.fs.vfs.vfs.INode
import geeos.fs.geefs.fs.{cleanUpGeeFs, geefs, initGeeFs}
import geeos.fs.devfs.fs.{cleanUpDevFs, initDevFs}


// root inode of filesystem
public var root_inode: INode var* = null


// initialize filesystem
public def initFileSystem() {
  // initialize GeeFS
  initGeeFs()
  // initialize DevFS
  initDevFs()
  // initialize root inode
  root_inode = geefs.getRoot()
  root_inode.open()
}

// clean up filesystem
public def cleanUpFileSystem() {
  // release root inode
  root_inode.close()
  root_inode = null
  // clean up GeeFS
  cleanUpGeeFs()
  // clean up DevFS
  cleanUpDevFs()
}
