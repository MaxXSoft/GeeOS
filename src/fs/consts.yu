// constant definitions about file system

// open files per thread
public inline let FILE_COUNT = 16

// flags for open: choose one of these
public inline let O_RDONLY   = 0           // open for reading only
public inline let O_WRONLY   = 1           // open for writing only
public inline let O_RDWR     = 2           // open for reading and writing
// then or in any of these:
public inline let O_CREAT    = 0x00000004  // create file if it does not exist
public inline let O_EXCL     = 0x00000008  // error if O_CREAT and the file exists
public inline let O_TRUNC    = 0x00000010  // truncate file upon open
public inline let O_APPEND   = 0x00000020  // append on each write
// additonal related definition
public inline let O_ACCMODE  = 3           // mask for O_RDONLY/O_WRONLY/O_RDWR

// flags for lseek
public inline let SEEK_SET   = 0
public inline let SEEK_CUR   = 1
public inline let SEEK_END   = 2
