import geeos.fs.vfs.vfs.INode
import geeos.fs.devfs.stdio.{StdIn, initStdIoOps, newStdIn, newStdInINode, newStdOutINode}


// inodes of stdio
public var stdin: INode var* = null
public var stdout: INode var* = null

// input buffer
var inbuffer: StdIn


// initialize device filesystem
public def initDevFs() {
  // initialize input buffer
  inbuffer = newStdIn()
  // initialize stdio
  initStdIoOps()
  stdin = newStdInINode(&inbuffer)
  stdout = newStdOutINode()
  // TODO: other devices
}

// clean up device file system
public def cleanUpDevFs() {
  // release stdio
  stdin.close()
  stdin = null
  stdout.close()
  stdout = null
  inbuffer.del()
  // TODO: other devices
}

// push character to input buffer
public def pushChar(c: u8) {
  if c == '\r' {
    inbuffer.push('\n')
  }
  else {
    inbuffer.push(c)
  }
}
