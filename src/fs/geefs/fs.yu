import geeos.fs.geefs.geefs.{initGeeFsOps, newGeeFs}
import geeos.fs.dev.device.DeviceInterface
import geeos.fs.vfs.vfs.FileSystem
import geeos.fs.dev.mem.{MemDevice, newMemDevice}
import geeos.lib.except.panic


// filesystem image embedded in kernel, defined in 'init.S'
extern declare _user_img_start: ()
extern declare _user_img_end: ()

// filesystem related objects
public var geefs: FileSystem var* = null
var dev: MemDevice


// initialize GeeFS
public def initGeeFs() {
  // initialize device
  dev = newMemDevice(_user_img_start as u8 var*,
                     _user_img_end as usize - _user_img_start as usize)
  // initialize GeeFS
  initGeeFsOps()
  geefs = newGeeFs(&dev as DeviceInterface var*)
  if geefs == null {
    panic("failed to open GeeFS")
  }
}

// clean up GeeFS
public def cleanUpGeeFs() {
  geefs.del()
  dev.del()
}
