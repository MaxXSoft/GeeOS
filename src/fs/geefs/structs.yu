// constants
public inline let MAGIC_NUM: u32          = 0x9eef5000
public inline let DIRECT_BLOCK_NUM: u32   = 12
public inline let BLOCK_OFS_SIZE     = sizeof u32 as u32
public inline let FILE_NAME_MAX_LEN: u32  = 28

// disk inode type
public enum GfsINodeType: u32 {
  Unused  = 0,
  File    = 1,
  Dir     = 2,
}

// super block header
public struct GfsSbHeader {
  public magic_num: u32,                   // magic number
  public header_size: u32,                 // size of current header
  public block_size: u32,                  // size of block
  public free_map_num: u32,                // number of free map blocks
  public inode_blk_num: u32,               // number of inode blocks
}

// free map block header
public struct GfsFmbHeader {
  public unused_num: u32,                  // number of unused blocks
}

// inode block header
public struct GfsInbHeader {
  public unused_num: u32,                  // number of unused inodes
}

// disk inode
public struct GfsINode {
  public itype: GfsINodeType,              // type of inode
  public size: u32,                        // size of file
  public block_num: u32,                   // number of blocks
  public direct: u32[DIRECT_BLOCK_NUM],    // direct blocks
  public indirect: u32,                    // indirect block id
  public indirect2: u32,                   // 2nd indirect block id
}

// directory entry
public struct GfsEntry {
  public inode_id: u32,                    // inode id of file
  public filename: u8[FILE_NAME_MAX_LEN],  // file name, ends with '\0'
}
