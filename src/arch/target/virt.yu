// arch definitions of QEMU virt

// constant address
public inline let FLASH_ADDR   = 0x20000000
public inline let MEM_ADDR     = 0x80000000
public inline let MEM_SIZE_MIB = 128
public inline let SWITCH_ADDR  = 0x00000000
public inline let LED_ADDR     = 0x00000000
public inline let NUM_ADDR     = 0x00000000
public inline let UART_ADDR    = 0x10000000
public inline let UART_END     = 0x10000100
public inline let PLIC_ADDR    = 0x0c000000
public inline let PLIC_END     = 0x0c400000
public inline let CLINT_MTIME  = 0x0200bff8
public inline let CLINT_MCMP   = 0x02004000

// UART related definitions
public inline let UART_DEV         = UART_ADDR as u8 volatile var*
public inline let UART_CLOCK_FREQ: u32  = 1843200
public inline let UART_BAUD_RATE: u32   = 115200
public inline let UART_RBR         = 0x00
public inline let UART_THR         = 0x00
public inline let UART_DLL         = 0x00
public inline let UART_DLM         = 0x01
public inline let UART_IER         = 0x01
public inline let UART_FCR         = 0x02
public inline let UART_LCR         = 0x03
public inline let UART_LSR         = 0x05
public inline let UART_LCR_DLAB: u8    = 0x80
public inline let UART_LCR_8BIT: u8    = 0x03
public inline let UART_LCR_PODD: u8    = 0x08
public inline let UART_LSR_DA: u8      = 0x01
public inline let UART_LSR_RI: u8      = 0x40

// initialize UART
public inline def initIO() {
  let divisor = UART_CLOCK_FREQ / ((16) * UART_BAUD_RATE)
  UART_DEV[UART_LCR] = UART_LCR_DLAB
  UART_DEV[UART_DLL] = divisor as u8
  UART_DEV[UART_DLM] = (divisor >> 8) as u8
  UART_DEV[UART_LCR] = UART_LCR_PODD | UART_LCR_8BIT
  UART_DEV[UART_FCR] = 0x07
  UART_DEV[UART_IER] = 0x01
}

// initialize PLIC
public inline def initIntr() {
  let UART_IRQ = 10
  let PLIC_UART_IRQ = (PLIC_ADDR + UART_IRQ * 4) as u32 volatile var*
  let S_MODE_INT_EN = (PLIC_ADDR + 0x2080) as u32 volatile var*
  let S_MODE_PRIORITY = (PLIC_ADDR + 0x201000) as u32 volatile var*
  (*PLIC_UART_IRQ) = 1
  (*S_MODE_INT_EN) = (1 << UART_IRQ) as u32
  (*S_MODE_PRIORITY) = 0
}

// Claim before servicing UART; complete after draining its receive FIFO.
public inline def ackIntr(): u32 {
  *((PLIC_ADDR + 0x201004) as u32 volatile var*)
}

public inline def finishIntr(irq: u32) {
  if irq != 0 {
    (*((PLIC_ADDR + 0x201004) as u32 volatile var*)) = irq
  }
}

// put character
public inline def putChar(c: u8) {
  while (UART_DEV[UART_LSR] & UART_LSR_RI) == 0 {}
  UART_DEV[UART_THR] = c
}

// get character
public inline def getChar(): i32 {
  if (UART_DEV[UART_LSR] & UART_LSR_DA) != 0 {
    UART_DEV[UART_RBR] as i32
  }
  else {
    -1
  }
}

// halt
public inline def halt(code: i32) {
  while true {}
}
