


// bytes per page
public inline let PAGE_SIZE      = (1 << 12)
public inline let MEGAPAGE_SIZE  = (1 << 22)

// count of PTEs per page
public inline let PTE_COUNT  = PAGE_SIZE / 4

// PTE flags
public inline let PTE_FLAG_V: usize = (1 << 0)
public inline let PTE_FLAG_R: usize = (1 << 1)
public inline let PTE_FLAG_W: usize = (1 << 2)
public inline let PTE_FLAG_X: usize = (1 << 3)
public inline let PTE_FLAG_U: usize = (1 << 4)
public inline let PTE_FLAG_G: usize = (1 << 5)
public inline let PTE_FLAG_A: usize = (1 << 6)
public inline let PTE_FLAG_D: usize = (1 << 7)

// recursive index
public inline let RECURSIVE_INDEX: usize  = 0x3fd
