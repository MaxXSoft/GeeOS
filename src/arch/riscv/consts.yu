public import arch.arch

// bytes per page
inline let PAGE_SIZE      = (1 << 12)
inline let MEGAPAGE_SIZE  = (1 << 22)

// count of PTEs per page
inline let PTE_COUNT  = PAGE_SIZE / 4

// PTE flags
inline let PTE_FLAG_V: usize = (1 << 0)
inline let PTE_FLAG_R: usize = (1 << 1)
inline let PTE_FLAG_W: usize = (1 << 2)
inline let PTE_FLAG_X: usize = (1 << 3)
inline let PTE_FLAG_U: usize = (1 << 4)
inline let PTE_FLAG_G: usize = (1 << 5)
inline let PTE_FLAG_A: usize = (1 << 6)
inline let PTE_FLAG_D: usize = (1 << 7)

// recursive index
inline let RECURSIVE_INDEX: usize  = 0x3fd
