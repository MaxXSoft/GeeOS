import geeos.arch.riscv.addr.Frame


// interface of frame allocator
public struct FrameAllocator {
  public alloc: (FrameAllocator var*): Frame,
}

// Allocate a frame of the appropriate size, panic on error.
public inline def alloc(this: FrameAllocator var*): Frame {
  ((*this).alloc)(this)
}

// interface of frame deallocator
public struct FrameDeallocator {
  public dealloc: (FrameDeallocator var*, Frame),
}

public inline def dealloc(this: FrameDeallocator var*, frame: Frame) {
  ((*this).dealloc)(this, frame)
}
