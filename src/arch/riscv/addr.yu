import geeos.arch.riscv.csr.getSatp


// 32-bit virtual addresss
public struct VirtAddr {
  addr: usize,
}

public inline def newVirtAddr(addr: usize): VirtAddr {
  [] {addr}
}

public inline def newVirtAddr(vpn1: usize, vpn0: usize, offset: usize): VirtAddr {
  [] {(vpn1 << 22) | (vpn0 << 12) | offset}
}

public inline def getAddr(this: VirtAddr&): usize {
  this.addr
}

public inline def getVpn1(this: VirtAddr&): usize {
  this.addr >> 22
}

public inline def getVpn0(this: VirtAddr&): usize {
  (this.addr >> 12) & 0x3ff
}

public inline def getVpn(this: VirtAddr&): usize {
  this.addr >> 12
}

public inline def getOffset(this: VirtAddr&): usize {
  this.addr & 0xfff
}

public inline def roundUp(this: VirtAddr&): VirtAddr {
  [] {(this.addr + 0xfff) & (~0xfff)}
}

public inline def roundDown(this: VirtAddr&): VirtAddr {
  [] {this.addr & (~0xfff)}
}

// 32-bit physical address
public struct PhysAddr {
  addr: usize,
}

public inline def newPhysAddr(addr: usize): PhysAddr {
  [] {addr}
}

public inline def getAddr(this: PhysAddr&): usize {
  this.addr
}

public inline def getPpn1(this: PhysAddr&): usize {
  this.addr >> 22
}

public inline def getPpn0(this: PhysAddr&): usize {
  (this.addr >> 12) & 0x3ff
}

public inline def getPpn(this: PhysAddr&): usize {
  this.addr >> 12
}

public inline def getOffset(this: PhysAddr&): usize {
  this.addr & 0xfff
}

public inline def roundUp(this: PhysAddr&): PhysAddr {
  [] {(this.addr + 0xfff) & (~0xfff)}
}

public inline def roundDown(this: PhysAddr&): PhysAddr {
  [] {this.addr & (~0xfff)}
}

// virtual page address
public struct Page {
  addr: VirtAddr,
}

public inline def newPage(addr: VirtAddr): Page {
  [] {addr.roundDown()}
}

public inline def newPage(vpn: usize): Page {
  [] {newVirtAddr(vpn << 12)}
}

public inline def newPage(vpn1: usize, vpn0: usize): Page {
  [] {newVirtAddr(vpn1, vpn0, 0)}
}

public inline def getAddr(this: Page&): VirtAddr {
  this.addr
}

public inline def getVpn1(this: Page&): usize {
  this.addr.getVpn1()
}

public inline def getVpn0(this: Page&): usize {
  this.addr.getVpn0()
}

public inline def getVpn(this: Page&): usize {
  this.addr.getVpn()
}

// physical frame address
public struct Frame {
  addr: PhysAddr,
}

public inline def newFrame(addr: PhysAddr): Frame {
  [] {addr.roundDown()}
}

public inline def newFrame(ppn: usize): Frame {
  [] {newPhysAddr(ppn << 12)}
}

public inline def newFrameFromSatp(): Frame {
  newFrame(getSatp() & 0x3fffff)
}

public inline def getAddr(this: Frame&): PhysAddr {
  this.addr
}

public inline def getPpn1(this: Frame&): usize {
  this.addr.getPpn1()
}

public inline def getPpn0(this: Frame&): usize {
  this.addr.getPpn0()
}

public inline def getPpn(this: Frame&): usize {
  this.addr.getPpn()
}

public inline def !=(this: Frame&, that: Frame): bool {
  this.addr.getAddr() != that.addr.getAddr()
}
