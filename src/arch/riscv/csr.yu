


// definitions about RISC-V CSR

// constants definitions
// machine status register
public inline let MSTATUS_MPP_MASK: usize = (3 << 11)
public inline let MSTATUS_MPP_M: usize    = (3 << 11)
public inline let MSTATUS_MPP_S: usize    = (1 << 11)
public inline let MSTATUS_MPP_U: usize    = (0 << 11)
public inline let MSTATUS_MIE: usize      = (1 << 3)
// supervisor status register
public inline let SSTATUS_SUM: usize      = (1 << 18)
public inline let SSTATUS_SPP: usize      = (1 << 8)
public inline let SSTATUS_SPIE: usize     = (1 << 5)
public inline let SSTATUS_UPIE: usize     = (1 << 4)
public inline let SSTATUS_SIE: usize      = (1 << 1)
public inline let SSTATUS_UIE: usize      = (1 << 0)
// supervisor interrupt enable
public inline let SIE_SEIE: usize         = (1 << 9)
public inline let SIE_STIE: usize         = (1 << 5)
public inline let SIE_SSIE: usize         = (1 << 1)
// machine-mode interrupt enable
public inline let MIE_MEIE: usize         = (1 << 11)
public inline let MIE_MTIE: usize         = (1 << 7)
public inline let MIE_MSIE: usize         = (1 << 3)
// supervisor address translation and protection
public inline let SATP_SV32: usize        = (1 << 31)
// trap cause
public inline let TRAP_S_SOFT_INT: usize  = ((1 << 31) | 1)
public inline let TRAP_S_EXT_INT: usize   = ((1 << 31) | 9)
public inline let TRAP_ILLEGAL: usize     = 2
public inline let TRAP_U_SYSCALL: usize   = 8
public inline let TRAP_INST_FAULT: usize  = 12
public inline let TRAP_LOAD_FAULT: usize  = 13
public inline let TRAP_STORE_FAULT: usize = 15

// declarations of functions in 'csr.S'
public extern declare getMstatus: (): usize
public extern declare setMstatus: (usize)
public extern declare setMepc: (usize)
public extern declare getSstatus: (): usize
public extern declare setSstatus: (usize)
public extern declare getSip: (): usize
public extern declare setSip: (usize)
public extern declare getSie: (): usize
public extern declare setSie: (usize)
public extern declare getMie: (): usize
public extern declare setMie: (usize)
public extern declare setSepc: (usize)
public extern declare getSepc: (): usize
public extern declare getMedeleg: (): usize
public extern declare setMedeleg: (usize)
public extern declare getMideleg: (): usize
public extern declare setMideleg: (usize)
public extern declare setStvec: (usize)
public extern declare getStvec: (): usize
public extern declare setMtvec: (usize)
public extern declare setSatp: (usize)
public extern declare getSatp: (): usize
public extern declare setSscratch: (usize)
public extern declare setMscratch: (usize)
public extern declare getScause: (): usize
public extern declare getStval: (): usize
public extern declare runSfence: (usize, usize)
public extern declare runSfencePage: (usize)
public extern declare initPmp: ()

public inline def runSfence() {
  asm { "sfence.vma" }
}

// enable device interrupts
public inline def setIntrOn() {
  setSie(getSie() | SIE_SEIE | SIE_STIE | SIE_SSIE)
  setSstatus(getSstatus() | SSTATUS_SIE)
}

// disable device interrupts
public inline def setIntrOff() {
  setSstatus(getSstatus() & ~SSTATUS_SIE)
}

// check if device interrupts are enabled
public inline def getIntr(): bool {
  (getSstatus() & SSTATUS_SIE) != 0
}

// make SATP value
public inline def makeSatp(pt_addr: usize): usize {
  (pt_addr >> 12) | SATP_SV32
}
