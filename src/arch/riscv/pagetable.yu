import geeos.arch.riscv.consts.{MEGAPAGE_SIZE, PTE_COUNT, PTE_FLAG_A, PTE_FLAG_D, PTE_FLAG_R, PTE_FLAG_V, PTE_FLAG_W, PTE_FLAG_X}
import geeos.arch.riscv.addr.{Frame, PhysAddr, newFrame, newPhysAddr}
import geeos.arch.riscv.framealloc.FrameDeallocator


// definition of RISC-V PTE
public struct PageTableEntry {
  public data: usize,
}

public inline def newPte(data: usize) {
  [PageTableEntry] {data}
}

public inline def isUnused(this: PageTableEntry&): bool {
  this.data == 0
}

public inline def setUnused(this: PageTableEntry var&) {
  this.data = 0
}

public inline def getFlags(this: PageTableEntry&): usize {
  this.data & 0xff
}

public inline def getFlag(this: PageTableEntry&, flag: usize): bool {
  (this.getFlags() & flag) != 0
}

public inline def isLeaf(this: PageTableEntry&): bool {
  let flag_vad = PTE_FLAG_V | PTE_FLAG_A | PTE_FLAG_D
  (this.getFlags() & ~flag_vad) != 0
}

public inline def setFlags(this: PageTableEntry var&, flags: usize) {
  this.data = (this.data & ~(0xff)) | flags
}

public inline def setFlag(this: PageTableEntry var&, flag: usize, value: bool) {
  let flags = if value {
    this.getFlags() | flag
  }
  else {
    this.getFlags() & ~flag
  }
  this.setFlags(flags)
}

public inline def clearFlag(this: PageTableEntry var&, flag: usize) {
  this.setFlag(flag, false)
}

public inline def getPpn(this: PageTableEntry&): usize {
  this.data >> 10
}

public inline def getAddr(this: PageTableEntry&): PhysAddr {
  newPhysAddr(this.getPpn() << 12)
}

public inline def getFrame(this: PageTableEntry&): Frame {
  newFrame(this.getPpn())
}

public inline def set(this: PageTableEntry var&, frame: Frame, flags: usize) {
  // Non-leaf entries reserve A/D; Fuxi requires them preset on leaves.
  let flags = if (flags & (PTE_FLAG_R | PTE_FLAG_X)) != 0 {
    flags | PTE_FLAG_A | PTE_FLAG_D
  }
  else {
    flags & ~(PTE_FLAG_A | PTE_FLAG_D)
  }
  this.data = (frame.getPpn() << 10) | flags
}

// RISC-V page table
public struct PageTable {
  ptes: PageTableEntry[PTE_COUNT],
}

public inline def getPte(this: PageTable var*, i: usize): PageTableEntry var& {
  (*this).ptes[i]
}

// clear all PTEs
public inline def zero(this: PageTable var*) {
  var i = 0
  while i < PTE_COUNT {
    (*this).ptes[i].setUnused()
    i += 1
  }
}

// deallocate & clear all avaliable non-leaf PTEs frames before `index`
public inline def clear(this: PageTable var*, index: usize,
                 dealloc: FrameDeallocator var*) {
  var i = 0
  while i as usize < index {
    let pte: PageTableEntry var& = this.getPte(i as usize)
    if !pte.isUnused() && !pte.isLeaf() {
      let frame = pte.getFrame()
      dealloc.dealloc(frame)
      pte.setUnused()
    }
    i += 1
  }
}

// Parameter `frame` is the actual physical frame where the
// root page table resides, it can be anywhere in the main memory.
// Denote `recursive_index` by K, then virtual address of the
// root page table is (K, K+1, 0) in Sv32.
public inline def setRecursive(this: PageTable var*, index: usize, frame: Frame) {
  (*this).ptes[index].set(frame, PTE_FLAG_V)
  (*this).ptes[index + 1].set(frame, PTE_FLAG_V | PTE_FLAG_R |
                                              PTE_FLAG_W)
}

// setup linear mapping for the page with `PPN[1]`
public inline def mapLinear(this: PageTable var*, ppn1: usize,
                     offset: usize, flags: usize) {
  let pa = newPhysAddr((ppn1 * MEGAPAGE_SIZE as usize) + offset)
  (*this).ptes[ppn1].set(newFrame(pa), flags)
}

// setup linear mapping of address range
// `begin` & `end` will be treated as virtual address
public inline def mapLinearRange(this: PageTable var*, begin: usize, end: usize,
                          offset: usize, flags: usize) {
  let begin_ppn = begin / MEGAPAGE_SIZE as usize
  let end_ppn = end / MEGAPAGE_SIZE as usize
  var ppn1 = begin_ppn
  while ppn1 <= end_ppn {
    this.mapLinear(ppn1, offset, flags)
    ppn1 += 1
  }
}
