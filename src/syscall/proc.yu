import geeos.proc.proc.{execute, exit, getCurrentTid, sleep, yield}
import geeos.syscall.user.userString


public def sysExit(code: usize): isize {
  exit(code)
  0
}

public def sysYield(): isize {
  yield()
  0
}

public def sysExecve(path: u8*, argv: u8**, envp: u8**): isize {
  if !userString(path) { return -1 }
  if execute(path, getCurrentTid()) {
    sleep()
    0
  }
  else {
    -1
  }
}
