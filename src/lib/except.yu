import geeos.arch.target.GEEOS_TARGET.halt
import geeos.lib.io.io


public def panic(str: u8*) {
  io <<< "===== KERNEL PANIC! =====\n"
  io <<< "message: " <<< str <<< '\n'
  halt(1)
}

public def abort() {
  panic("abort")
}

public def assert(cond: bool, str: u8*) {
  if !cond { panic(str) }
}

public def assert(cond: bool) {
  if !cond { abort() }
}
