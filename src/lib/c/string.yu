public import arch.arch

extern def memset(dst: u8 var*, c: i32, n: usize): u8 var* {
  var d = dst, remaining = n
  let byte = c as u8
  // Only issue aligned word stores: Fuxi does not support unaligned accesses.
  while remaining != 0 as usize && ((d as usize) & (3 as usize)) != 0 as usize {
    *d = byte
    d += 1
    remaining -= 1 as usize
  }
  let word = (byte as u32) * (0x01010101 as u32)
  var words = d as u32 var*
  while remaining >= 16 as usize {
    words[0] = word
    words[1] = word
    words[2] = word
    words[3] = word
    words += 4
    remaining -= 16 as usize
  }
  while remaining >= 4 as usize {
    *words = word
    words += 1
    remaining -= 4 as usize
  }
  d = words as u8 var*
  while remaining != 0 as usize {
    *d = byte
    d += 1
    remaining -= 1 as usize
  }
  dst
}

extern def memmove(dst: u8 var*, src: u8*, n: usize): u8 var* {
  var s = src, d = dst, n = n
  if s < d && s + n > d {
    // overlapped
    s += n
    d += n
    while n > 0 as usize {
      d -= 1
      s -= 1
      (*d) = *s
      n -= 1 as usize
    }
  }
  else {
    while n > 0 as usize {
      *d = *s
      d += 1
      s += 1
      n -= 1 as usize
    }
  }
  dst
}

extern def memcpy(dst: u8 var*, src: u8*, n: usize): u8 var* {
  memmove(dst, src, n)
}

extern def memcmp(lhs: u8*, rhs: u8*, count: usize): i32 {
  var l = lhs, r = rhs, n = 0 as usize
  while n < count {
    if l[n] != r[n] {
      return l[n] as i32 - r[n] as i32
    }
    n += 1 as usize
  }
  0
}

extern def strlen(str: u8*): usize {
  var len = 0
  while str[len] != '\0' {
    len += 1
  }
  len as usize
}
