


public type HeapAllocator = (usize): u8 var*
public type HeapDeallocator = (u8 var*)

public struct HeapManager {
  alloc: HeapAllocator,
  dealloc: HeapDeallocator,
}

public var heap: HeapManager = [] {}


public inline def init(this: HeapManager var&, alloc: HeapAllocator,
                dealloc: HeapDeallocator) {
  this.alloc = alloc
  this.dealloc = dealloc
}

public inline def alloc(this: HeapManager&, size: usize): u8 var* {
  (this.alloc)(size)
}

public inline def dealloc(this: HeapManager&, ptr: u8 var*) {
  (this.dealloc)(ptr)
}
