import geeos.lib.io.io
import geeos.trap.trap.initTrap
import geeos.mem.mem.initMem
import geeos.fs.fs.initFileSystem
import geeos.proc.proc.{initProcess, runCpu}


// supervisor mode entry of GeeOS
public def main() {
  io <<< "initializing trap handler...\n"
  initTrap()
  io <<< "initializing memory...\n"
  initMem()
  io <<< "initializing filesystem...\n"
  initFileSystem()
  io <<< "initializing process manager...\n"
  initProcess()
  io <<< "done!\n\n"
  runCpu()
}
