// constants
public inline let FILE_NAME_MAX_LEN: u32  = 28

// file type
public enum FileType {
  File, Dir, CharDevice, BlockDevice,
}

// file status
public struct Stat {
  public ino: u32,
  public file_type: FileType,
  public size: usize,
  public blk_size: usize,
  public blocks: usize,
}

// directory entry
public struct Dirent {
  public inode_id: u32,
  public filename: u8[FILE_NAME_MAX_LEN],
}
